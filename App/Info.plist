	<key>NonetPurchaseURL</key>
	<string>$(NONET_PURCHASE_URL)</string>
	<key>NonetSupportURL</key>
	<string>$(NONET_SUPPORT_URL)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>$(NONET_APPCAST_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(NONET_SPARKLE_PUBLIC_KEY)</string>
