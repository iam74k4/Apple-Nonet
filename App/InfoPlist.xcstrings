{
  "sourceLanguage" : "ja",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonet asks your browser for the URL of the current page to pass it to your script, and asks Finder which files you've selected so it can rename, duplicate or move them to the Trash."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "スクリプトに渡すためにブラウザで表示中のページの URL を取得し、ファイルのアクションのために Finder で選んでいるファイルを調べて、名前の変更・複製・ゴミ箱に入れる操作をします。"
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription" : {
      "comment" : "Privacy - Desktop Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonet lists the files on your Desktop so the Recent Screenshots button can show the screenshots saved there."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "最近のスクショのマスで、デスクトップに保存されたスクリーンショットを並べるために、デスクトップのファイルの一覧を読みます。"
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription" : {
      "comment" : "Privacy - Documents Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonet lists the files in your Documents folder so the Recent Screenshots button can show the screenshots you save there."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "最近のスクショのマスで、スクリーンショットの保存先に選んだ書類フォルダの中のスクリーンショットを並べるために、ファイルの一覧を読みます。"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription" : {
      "comment" : "Privacy - Downloads Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonet lists the files in your Downloads folder so the Recent Screenshots button can show the screenshots you save there."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "最近のスクショのマスで、スクリーンショットの保存先に選んだダウンロードフォルダの中のスクリーンショットを並べるために、ファイルの一覧を読みます。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
