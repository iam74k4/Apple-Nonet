#!/bin/bash
# テスト用の偽の hdiutil。create では中身の一覧を記録し、ビルド番号と SUFeedURL 入りの偽の DMG を作る
set -euo pipefail
printf 'hdiutil %s\n' "$*" >>"${FAKE_LOG:?}"

case "${1:-}" in
  create)
    out="${*: -1}"
    src=""
    while [[ $# -gt 0 ]]; do
      [[ "$1" != -srcfolder ]] || src="$2"
      shift
    done
    printf 'hdiutil srcfolder: %s\n' "$(cd "${src:?}" && printf '%s ' *)" >>"$FAKE_LOG"
    if [[ -L "$src/Applications" ]]; then
      printf 'hdiutil applications-link: %s\n' "$(readlink "$src/Applications")" >>"$FAKE_LOG"
    fi
    plist="$src/Nonet.app/Contents/Info.plist"
    build="$(plutil -extract CFBundleVersion raw -o - "$plist")"
    feed="$(plutil -extract SUFeedURL raw -o - "$plist" 2>/dev/null || true)"
    printf 'fake dmg build=%s feed=%s\n' "$build" "$feed" >"$out"
    ;;
  verify) ;;
  *) exit 1 ;;
esac
