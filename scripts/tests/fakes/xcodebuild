#!/bin/bash
# テスト用の偽の xcodebuild。引数を FAKE_LOG に記録し、解決・アーカイブ・書き出し・ビルドの成果物を最小限の形で作る。
#   FAKE_XCODEBUILD_STATUS        0 以外ならすべての呼び出しで失敗する
#   FAKE_XCODEBUILD_FAIL_ACTION   この操作（resolve / archive / export / build）だけ失敗する
#   FAKE_PLIST_*                  作る Info.plist の販売用の値
#   FAKE_NESTED_MACHO             1 なら Sparkle.framework に Mach-O の実行ファイルを入れる
#   FAKE_NO_SPARKLE_ARTIFACTS     1 ならパッケージの解決で Sparkle のツールを置かない
#   FAKE_SELF_CHECK_STATUS        作ったアプリを動かしたときの終了コード（既定は 0）
#   FAKE_SELF_CHECK_OUTPUT        --self-check で作ったアプリが出す1行（既定は、終了コードが 0 なら ok: true、そうでなければ ok: false の JSON。
#                                 空文字にすると何も出さない）
#   FAKE_SELF_CHECK_HANG          1 なら --self-check で終わらない（NONET_SELF_CHECK_TIMEOUT の確認用）
#   FAKE_APP_DEBUG_TEXT           作ったアプリの実行ファイルに足す文字列（DEBUG ビルドだけのコードが混ざった Release の再現）
set -euo pipefail
printf 'xcodebuild %s\n' "$*" >>"${FAKE_LOG:?}"

action="" derived="" archive="" export_path="" options="" version="1.0" build="1"
while [[ $# -gt 0 ]]; do
  case "$1" in
    archive | build) action="$1" ;;
    -resolvePackageDependencies) action=resolve ;;
    -exportArchive) action="export" ;;
    -version)
      printf 'Xcode 27.1\nBuild version 27A0000\n'
      exit 0
      ;;
    -derivedDataPath) derived="$2" && shift ;;
    -archivePath) archive="$2" && shift ;;
    -exportPath) export_path="$2" && shift ;;
    -exportOptionsPlist) options="$2" && shift ;;
    MARKETING_VERSION=*) version="${1#*=}" ;;
    CURRENT_PROJECT_VERSION=*) build="${1#*=}" ;;
  esac
  shift
done

if [[ "${FAKE_XCODEBUILD_STATUS:-0}" != 0 || "${FAKE_XCODEBUILD_FAIL_ACTION:-}" == "$action" ]]; then
  printf 'error: 偽の xcodebuild が %s で失敗しました\n** FAILED **\n' "$action" >&2
  exit "${FAKE_XCODEBUILD_STATUS:-65}"
fi

write_app() {
  local app="$1"
  mkdir -p "$app/Contents/MacOS"
  # アプリの実行ファイルの代わり。呼ばれたら FAKE_LOG に記録し、--self-check には JSON を1行出して FAKE_SELF_CHECK_STATUS で終わる
  cat >"$app/Contents/MacOS/Nonet" <<'APP'
#!/bin/sh
printf 'Nonet %s\n' "$*" >>"${FAKE_LOG:?}"
printf 'Nonet executable: %s\n' "$0" >>"$FAKE_LOG"
[ "${FAKE_SELF_CHECK_HANG:-}" != 1 ] || exec sleep 30
if [ "$*" = "--self-check" ]; then
  status="${FAKE_SELF_CHECK_STATUS:-0}"
  if [ -n "${FAKE_SELF_CHECK_OUTPUT+x}" ]; then
    [ -z "$FAKE_SELF_CHECK_OUTPUT" ] || printf '%s\n' "$FAKE_SELF_CHECK_OUTPUT"
  elif [ "$status" = 0 ]; then
    printf '%s\n' '{"accessibilityGranted":false,"configurationRoundTrip":{"ok":true},"failures":[],"installedLauncherCandidates":3,"launcherCandidates":9,"multitouch":{"devices":1,"loaded":true,"trackpadAvailable":true},"ok":true,"presets":20,"version":"1.0.0 (1)"}'
  else
    printf '%s\n' '{"configurationRoundTrip":{"ok":true},"failures":["multitouch"],"multitouch":{"devices":0,"loaded":false},"ok":false,"presets":20,"version":"1.0.0 (1)"}'
  fi
fi
exit "${FAKE_SELF_CHECK_STATUS:-0}"
APP
  chmod +x "$app/Contents/MacOS/Nonet"
  if [[ -n "${FAKE_APP_DEBUG_TEXT:-}" ]]; then
    printf '# %s\n' "$FAKE_APP_DEBUG_TEXT" >>"$app/Contents/MacOS/Nonet"
  fi
  cat >"$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.iam74k4.Nonet</string>
	<key>CFBundleShortVersionString</key>
	<string>$version</string>
	<key>CFBundleVersion</key>
	<string>$build</string>
	<key>SUFeedURL</key>
	<string>${FAKE_PLIST_FEED:-}</string>
	<key>SUPublicEDKey</key>
	<string>${FAKE_PLIST_ED_KEY:-}</string>
	<key>NonetPurchaseURL</key>
	<string>${FAKE_PLIST_PURCHASE:-}</string>
	<key>NonetLicensePublicKey</key>
	<string>${FAKE_PLIST_LICENSE_KEY:-}</string>
	<key>NonetSupportEmail</key>
	<string>${FAKE_PLIST_SUPPORT_EMAIL:-}</string>
</dict>
</plist>
EOF
  if [[ -n "${FAKE_NESTED_MACHO:-}" ]]; then
    # 本物の Sparkle と同じ置き方: 実行ファイル（Autoupdate・Updater.app・XPC サービス）と dylib（Sparkle 本体）
    local sparkle="$app/Contents/Frameworks/Sparkle.framework/Versions/B" executable
    for executable in Autoupdate Updater.app/Contents/MacOS/Updater \
      XPCServices/Downloader.xpc/Contents/MacOS/Downloader XPCServices/Installer.xpc/Contents/MacOS/Installer; do
      mkdir -p "$(dirname "$sparkle/$executable")"
      cp /usr/bin/true "$sparkle/$executable"
    done
    # Mach-O の dylib（MH_DYLIB）の頭だけ。tr はバイト列として扱う（UTF-8 のロケールでは「Illegal byte sequence」で止まる）
    printf '\xcf\xfa\xed\xfe\x0c\x00\x00\x01\x00\x00\x00\x00\x06\x00\x00\x00%28s' "" | LC_ALL=C tr ' ' '\0' >"$sparkle/Sparkle"
    chmod +x "$sparkle/Sparkle"
  fi
}

case "$action" in
  resolve)
    mkdir -p "${derived:?}/SourcePackages/artifacts"
    if [[ -z "${FAKE_NO_SPARKLE_ARTIFACTS:-}" ]]; then
      bin="$derived/SourcePackages/artifacts/sparkle/Sparkle/bin"
      mkdir -p "$bin"
      cp "$(dirname "$0")/sparkle/generate_appcast" "$(dirname "$0")/sparkle/generate_keys" "$bin/"
    fi
    ;;
  archive)
    write_app "${archive:?}/Products/Applications/Nonet.app"
    ;;
  export)
    printf 'export method=%s team=%s\n' \
      "$(plutil -extract method raw -o - "${options:?}")" \
      "$(plutil -extract teamID raw -o - "$options")" >>"$FAKE_LOG"
    mkdir -p "${export_path:?}"
    cp -R "${archive:?}/Products/Applications/Nonet.app" "$export_path/"
    ;;
  build)
    write_app "${derived:?}/Build/Products/Debug/Nonet.app"
    ;;
esac
