#!/bin/bash
# テスト用の偽の curl。ネットワークには出ない。
#   FAKE_CURL_BODY    このファイルを -o の先にコピーして成功する
#   FAKE_CURL_STATUS  終了コード（既定 22 = HTTP のエラー。公開中の appcast がまだ無い状態）
set -euo pipefail
printf 'curl %s\n' "$*" >>"${FAKE_LOG:?}"

out=""
while [[ $# -gt 0 ]]; do
  [[ "$1" != -o ]] || out="$2"
  shift
done
if [[ -n "${FAKE_CURL_BODY:-}" ]]; then
  cp "$FAKE_CURL_BODY" "${out:?}"
  exit 0
fi
exit "${FAKE_CURL_STATUS:-22}"
