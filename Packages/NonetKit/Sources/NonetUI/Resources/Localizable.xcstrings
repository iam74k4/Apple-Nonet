      }
    },
    "開いたとき・隣のアイコンに移ったとき・実行したときに、トラックパッドが軽く振動します（感圧タッチのトラックパッドだけ）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
