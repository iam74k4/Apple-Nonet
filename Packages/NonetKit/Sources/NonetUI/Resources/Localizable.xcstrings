          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Open System Settings, then turn on Nonet in Privacy & Security › Accessibility."
          }
        }
      }
    },
    "「プロファイルを追加」で、アプリごとの9マスを作れます" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Add Profile to give an app its own nine buttons."
          }
        }
      }
    },
    "あとで設定する" : {
      "localizations" : {
