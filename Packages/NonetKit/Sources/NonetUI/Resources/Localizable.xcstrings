{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@ が前面にあるとき" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When %@ is in front"
          }
        }
      }
    },
    "%@ が前面にあるときに使う9マス" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nine buttons used when %@ is in front"
          }
        }
      }
    },
    "%@ では Nonet を使いません。トリガーキーもトラックパッドもいつもどおり働きます" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonet is off in %@. The trigger key and trackpad work as usual."
          }
        }
      }
    },
    "%@ ではグローバルのボタンを使います。このプロファイルのボタンは残しています" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uses the Global buttons. This profile’s buttons are kept."
          }
        }
      }
    },
    "%@ のプロファイル" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ profile"
          }
        }
      }
    },
    "%@ のページ %lld" : {
