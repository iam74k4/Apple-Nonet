      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each time the HUD opens, Nonet measures the brightness of the screen under it and draws each icon in white or black. The image is discarded at once; nothing is saved or sent"
          }
        }
      }
    },
