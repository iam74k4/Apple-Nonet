          }
        }
      }
    },
    "いまのは%@の「%@」です。「%@」は%@にあります。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That was “%2$@” (%1$@). “%3$@” is at the %4$@."
