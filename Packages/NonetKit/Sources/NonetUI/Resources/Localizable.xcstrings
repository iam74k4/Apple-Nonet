      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Menus"
          }
        }
      }
    },
    "%@、%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@、%2$@"
          }
        }
      }
    },
    "%@、%@、%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@, %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@、%2$@、%3$@"
          }
        }
      }
    },
    "%@の角に指を1本置いて、そのまま少し待ちます。HUD が出たら、指を滑らせて選び、離すと実行します" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest one finger in the %@ corner and wait a moment. When the HUD appears, slide to a button and lift your finger to run it."
          }
        }
      }
    },
    "%@の設定に戻しました。戻す前の設定も「以前の設定に戻す」に残しています。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restored the settings from %@. The settings from before are kept in Restore an Earlier Version."
          }
        }
      }
    },
    "%@の設定に戻しますか？" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore the settings from %@?"
          }
        }
      }
    },
    "%@を押したまま、トラックパッドに指を置いて止めます。HUD が出たら、指を滑らせて「%@」に合わせ、%@を離してください" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold %1$@ and rest a finger on the trackpad. When the HUD appears, slide to “%2$@” and release %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@を押したまま、トラックパッドに指を置いて止めます。HUD が出たら、指を滑らせて「%2$@」に合わせ、%3$@を離してください"
          }
        }
      }
    },
    "%@を押したまま、トラックパッドに指を置いて止めます。HUD が出たら、指を滑らせて「%@」に合わせ、指を離してください" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold %1$@ and rest a finger on the trackpad. When the HUD appears, slide to “%2$@” and lift your finger."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@を押したまま、トラックパッドに指を置いて止めます。HUD が出たら、指を滑らせて「%2$@」に合わせ、指を離してください"
          }
        }
      }
    },
    "%@を押して、%@の「%@」をすぐにタップしてください" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold %1$@ and tap “%3$@” (%2$@) right away."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@を押して、%2$@の「%3$@」をすぐにタップしてください"
          }
        }
      }
    },
    "%@を押しながら、トラックパッドの右上をタップ" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold %@ and tap the top-right corner of the trackpad"
          }
        }
      }
    },
    "%@キーを押している間だけ、トラックパッドがアプリごとに変わる9つのボタンになります" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold %@ and your trackpad turns into nine buttons that change with each app."
          }
